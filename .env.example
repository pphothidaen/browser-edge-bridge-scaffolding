# Browser Edge Bridge Environment Configuration Template
# Dual-Role Authentication Tokens
BRIDGE_SECRET="example-bridge-secret-token"
CLIENT_API_KEY="example-client-api-key"

# Worker and Server Settings
PORT=8787
ENVIRONMENT="development"
DEFAULT_MODEL="model-example"
TARGET_ORIGIN="https://target.example.local"

# Remote Bridge Endpoint for Clients and CLI
BRIDGE_URL="https://bridge.example.workers.dev"
